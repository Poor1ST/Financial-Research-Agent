# Required
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google OAuth (required for "Sign in with Google")
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
FRONTEND_URL=https://your-frontend.onrender.com
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/auth/google/callback

# JWT (change in production)
JWT_SECRET=a-long-random-secret-string

# Render assigns $PORT automatically; you can override locally
PORT=8000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

# Persistent disk paths (mount Render disk at /app/data)
CHROMA_DIR=/app/data/chromadb_storage
DB_PATH=/app/data/chat.db
# SQLALCHEMY_DATABASE_URL=sqlite:////app/data/chat.db
